#include <windows.h>
1 ICON "cyclara.ico"
1 RT_MANIFEST "Cyclara.exe.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @COMMAS@
 PRODUCTVERSION @COMMAS@
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Aswadh Shyma Sajeevan"
      VALUE "FileDescription",  "Cyclara"
      VALUE "FileVersion",      "@VERSION@"
      VALUE "InternalName",     "Cyclara"
      VALUE "LegalCopyright",   "GPL-3.0-or-later"
      VALUE "OriginalFilename", "Cyclara.exe"
      VALUE "ProductName",      "Cyclara"
      VALUE "ProductVersion",   "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
