    given-names: "Aswadh"
version: 0.9.0
date-released: 2026-10-21
license: GPL-3.0-or-later
url: "https://github.com/asajeevan/electrochem-toolkit"
repository-code: "https://github.com/asajeevan/electrochem-toolkit"
keywords:
  - battery cycling
  - electrochemistry
  - BioLogic EC-Lab
  - differential capacity
  - data analysis
